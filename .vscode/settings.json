{
  // 解释器指向 uv 建在项目里的 .venv。不指定的话（尤其在多根工作区下）Pylance
  // 会退回全局解释器，于是 fastapi / structlog / motor 全部标红「无法解析导入」——
  // 包其实都在，只是没人告诉编辑器去哪儿找。
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",

  // 保存时用 ruff 格式化，与 CI 同一个工具、同一份配置（pyproject.toml，行宽 100）。
  // ⚠️ 这条是刻意覆盖全局设置里的 autopep8。装了 ruff 扩展不等于在用它 —— 决定用
  // 谁的是这里的 defaultFormatter。全局那套的参数是 --max-line-length 222，于是一行
  // 150 字符在它看来完全合规、不会拆，本地保存看着一切正常，推上去才被 CI 的
  // `ruff format --check`（100 列）拦下。需要 charliermarsh.ruff 扩展，见 extensions.json。
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.organizeImports.ruff": "explicit"
    }
  },

  "python.testing.pytestEnabled": true,
  "python.testing.unittestEnabled": false,
  "python.testing.pytestArgs": ["tests"],

  // 与 ruff 的 line-length 对齐，写的时候就看得见边界
  "editor.rulers": [100],

  "search.exclude": {
    "**/.venv": true,
    "**/.ruff_cache": true,
    "**/.mypy_cache": true,
    "**/.pytest_cache": true
  }
}
