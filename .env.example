# 拷成 .env 再填。.env 已被 gitignore，也必须一直保持这样 ——
# 完整边界见 docs/design/2026-08-19-mvp-design.md 第八节。
#
# 生成密码：openssl rand -base64 24
#
# 下面的 *_PORT 有**两个**用途，别只记住一个：
#   1. 宿主机侧的端口映射 —— 本机 5432 / 6379 被别的栈或 SSH 隧道占了就改个号；
#   2. **本机直接跑时**（make dev / make test-int）应用连的就是它。
# 容器之间不受影响：compose 给 api 注入的是服务名 + 容器内默认端口，不读这里。
# 连接串一律由这些零件拼出来，不存在「整条 URI」这种配置项 —— 那会让同一个端口
# 有两处真相，迟早不一致。

# --- 应用 -------------------------------------------------------------------
ENVIRONMENT=dev          # dev | test | prod
DEBUG=true
API_PORT=8000

# --- 认证：token 签发密钥 + 运营账号（D9 起）---------------------------------
# 生成密钥：openssl rand -base64 32
#
# 空着能起来，但**认证层会拒绝工作** —— 签不出 token 也验不过 token，登录接口
# 返回 503。这不是「凭据留了个空默认值」：它不会退化成「用空串当密钥」那种看起来
# 一切正常、实际上等于没有认证的状态。ENVIRONMENT=prod 时这一项和下面的密码哈希
# 都必填，缺了进程直接起不来。
AUTH_SECRET=

# 运营账号。**不建用户表**（单实例单使用者，理由见设计文档 2026-08-21 第五节），
# 多人共用这一个账号。
OPERATOR_USERNAME=admin
# 🔴 存**哈希**不存明文，生成：uv run python -m adpilot.auth.password
#
# **单引号不能省。** argon2 的哈希串长这样 `$argon2id$v=19$m=65536,...`，而
# docker compose 读 .env 时会把不带引号的值里的 `$argon2id` 当成变量展开成空串，
# 于是容器里的哈希只剩半截 —— 症状是「本机登录得了，compose 起的那套登录不了」。
OPERATOR_PASSWORD_HASH=

# --- PostgreSQL：客户、广告账户、日指标、结算 --------------------------------
POSTGRES_DB=adpilot
POSTGRES_USER=adpilot
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

# --- MongoDB：append-only 的原始报表快照 -------------------------------------
MONGO_USER=adpilot
MONGO_PASSWORD=
MONGO_DB=adpilot_raw
MONGO_PORT=27017
# 账号建在哪个库里。用 root 账号（compose 那份就是）时是 admin；连一个已有的
# Mongo、账号建在业务库下的话改成那个库名。
MONGO_AUTH_SOURCE=admin

# --- Redis：平台 API 限流、热点指标缓存 --------------------------------------
REDIS_PORT=6379
REDIS_DB=0
# Celery 的任务结果存在另一个 db 号里，跟缓存分开 —— 清缓存（FLUSHDB）不该顺手
# 把「那个任务成没成」一起清掉。
REDIS_CELERY_DB=1
# 空着是正常的：compose 里的 Redis 没开 requirepass。真给它配了密码才填。
REDIS_PASSWORD=

# --- RabbitMQ：Celery 的消息队列 ---------------------------------------------
RABBITMQ_USER=adpilot
RABBITMQ_PASSWORD=
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672
# RabbitMQ 侧的命名空间。自己起的那台用默认的 `/` 就行；连一台别人也在用的
# RabbitMQ 时必须换一个，否则两个系统的队列名会在同一个空间里撞。
RABBITMQ_VHOST=/

# --- 告警通知：配了就推，没配就只记日志 -------------------------------------
# 🔴 **这是凭据。** 企业微信 / 钉钉 / 飞书的 webhook 地址里直接带着 key，泄一次
# 等于把发消息的权限交出去 —— 所以它和密码一样不进仓库。
# 空着是正常状态：告警照样落库、接口照样查得到，只是不会主动推给你。
# 发出去的是通用 JSON，不迁就任何一家的消息格式（挑一家等于把其余几家挡在门外），
# 中间加个 n8n / 云函数转一下即可。
# ALERT_WEBHOOK_URL=

# --- LLM：任何兼容 OpenAI 协议的服务（D13 起）--------------------------------
# 不绑定任何一家。DeepSeek、Kimi、通义、本地 Ollama 或 vLLM 都能直接接；Claude 和
# Gemini 也各有 OpenAI 兼容端点，所以**不写原生适配器**（理由见
# docs/design/2026-08-21-llm-reports.md 第六节）。
#
# 三项空着是**正常状态**：日报照样生成，只是那一行人话空着并标注「未生成」——
# 数字部分是确定性的，不该被模型的可用性绑架。
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
# 🔴 是凭据。但**本地 Ollama / vLLM 不校验它**，所以空着不算「凭据留了默认值」；
# 「配没配 LLM」的判据是上面那两项。
# LLM_API_KEY=

# 每天最多调几次。不是省钱，是防失控：一个写错的循环能在夜里把额度跑光，而自托管
# 意味着花的是你自己的钱。默认 200，够日报和按需诊断用。
# LLM_DAILY_CALL_LIMIT=200

# 每百万 token 的价格，用来估成本。**留空（0）表示不估**，那时 llm_calls 里的
# estimated_cost 是 NULL（「不知道」）而不是 0（「免费」）。币种你自己心里有数 ——
# 这里不记，因为对账时你本来就知道用的是谁家。
# LLM_INPUT_COST_PER_MTOK=
# LLM_OUTPUT_COST_PER_MTOK=

# --- 广告平台凭据（里程碑 D3 起；走文件导入的话不需要）-----------------------
# META_ACCESS_TOKEN=
# TIKTOK_ACCESS_TOKEN=
