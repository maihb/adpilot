# 拷成 .env 再填。.env 已被 gitignore，也必须一直保持这样 ——
# 完整边界见 docs/design/2026-08-19-mvp-design.md 第八节。
#
# 生成密码：openssl rand -base64 24
#
# 下面的 *_PORT 只影响宿主机侧映射。容器之间靠服务名 + 默认端口互通，跟这里无关，
# 所以本机的 5432 / 6379 已经被别的栈或 SSH 隧道占了的话，改个号就行，不会牵动别处。

# --- 应用 -------------------------------------------------------------------
ENVIRONMENT=dev          # dev | test | prod
DEBUG=true
API_PORT=8000

# --- PostgreSQL：客户、广告账户、日指标、结算 --------------------------------
POSTGRES_DB=adpilot
POSTGRES_USER=adpilot
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

# --- MongoDB：append-only 的原始报表快照 -------------------------------------
MONGO_USER=adpilot
MONGO_PASSWORD=
MONGO_DB=adpilot_raw
MONGO_PORT=27017
# ⚠️ 本机直接跑（make dev / make test-int）连的是**这一条**，不是上面那几项拼出来的
# —— 容器里的那份由 docker-compose.yml 用服务名另拼一条，不读这里。所以改了
# MONGO_PORT 一定要顺手改这里的端口，否则症状是「compose 里好好的，本机连不上」。
MONGO_URI=mongodb://adpilot:把上面那个密码填这@localhost:27017/?authSource=admin

# --- Redis：平台 API 限流、热点指标缓存 --------------------------------------
REDIS_PORT=6379
# 同上：本机直接跑时用这一条，端口要和 REDIS_PORT 对上。宿主机上跑着别的 Redis
# 时尤其要确认 —— 连错了会报一句看起来毫不相干的认证错误。
REDIS_URL=redis://localhost:6379/0

# --- RabbitMQ：异步拉报表与定时任务（里程碑 D6 起启用）-----------------------
RABBITMQ_USER=adpilot
RABBITMQ_PASSWORD=
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672

# --- LLM：任何兼容 OpenAI 协议的服务 -----------------------------------------
# 不绑定任何一家。DeepSeek、Kimi、通义、本地 Ollama 或 vLLM 都能直接接。
# Claude 与 Gemini 的原生适配器作为示例放在 src/adpilot/llm/providers/。
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=
# LLM_MODEL=

# --- 广告平台凭据（里程碑 D3 起；走文件导入的话不需要）-----------------------
# META_ACCESS_TOKEN=
# TIKTOK_ACCESS_TOKEN=
